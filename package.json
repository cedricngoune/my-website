{
  "name": "portfolio-cedric",
  "version": "2.0.0",
  "private": true,
  "description": "Portfolio de Cédric Ngouné — monorepo (v1 : site actuel, v2 : nouvelle version)",
  "author": "Cédric Ngouné",
  "license": "ISC",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "start": "yarn dev:v1 & yarn dev:v2",
    "dev:v1": "yarn workspace @portfolio/v1 dev",
    "dev:v2": "yarn workspace @portfolio/v2 dev",
    "build:v1": "yarn workspace @portfolio/v1 build",
    "build:v2": "yarn workspace @portfolio/v2 build",
    "start:v1": "yarn workspace @portfolio/v1 start",
    "start:v2": "yarn workspace @portfolio/v2 start",
    "lint": "yarn workspaces run lint",
    "typecheck": "yarn workspaces run typecheck"
  },
  "engines": {
    "node": ">=22"
  }
}
